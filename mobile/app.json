{
  "expo": {
    "name": "Fusion",
    "slug": "fusion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fusion",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/468e8d09-737d-464b-8b5a-95d629005ed7",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gajocreative.fusion",
      "buildNumber": "42",
      "infoPlist": {
        "NSCameraUsageDescription": "Fusion needs camera access for face verification and video calls.",
        "NSMicrophoneUsageDescription": "Fusion needs microphone access for voice and video calls.",
        "NSPhotoLibraryUsageDescription": "Fusion needs photo access so you can add photos to your profile.",
        "UIBackgroundModes": ["voip", "remote-notification", "audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gajocreative.fusion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F1826"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1826"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://www.fusioncouples.co.uk",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "468e8d09-737d-464b-8b5a-95d629005ed7"
      }
    }
  }
}
